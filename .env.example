# Secrets are never read from the environment or from a dotfile — they live
# only in the macOS Keychain (ADR-0009). Every value below is a non-secret
# placeholder; none of them is a credential.

# Short, fixed runtime directory holding the socket, database, logs, and
# spool. Never the randomized per-user $TMPDIR — see docs/adr/0001.
CCC_RUNTIME_DIR=~/.claude-command-center

# The Unix domain socket path the companion service binds and the plugin
# dials. Must stay under the 104-byte macOS sun_path cap.
CCC_SOCKET_PATH=~/.claude-command-center/svc.sock

# Structured log verbosity for the companion service.
CCC_LOG_LEVEL=info
