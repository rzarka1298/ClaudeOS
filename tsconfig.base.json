{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "files": [],
  "references": [
    { "path": "packages/domain" },
    { "path": "packages/operational-store" },
    { "path": "packages/service" },
    { "path": "packages/service-api-client" },
    { "path": "packages/plugin" },
    { "path": "packages/test-fixtures" },
    { "path": "packages/adapters" },
    { "path": "packages/vault-repo" },
    { "path": "packages/scheduler" },
    { "path": "packages/collectors" },
    { "path": "packages/launchers" },
    { "path": "packages/keychain" }
  ]
}
