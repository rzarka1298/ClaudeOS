        <ul class="ccc-source-list">
          <li class="ccc-source-row">Research reports — no source yet</li>
        </ul>
      </div>
    </footer>
  </div>
  <p class="ccc-research-status" role="status">
  </p>
  <section class="ccc-research-run-status" aria-labelledby="ID">
    <h3 id="ID" class="ccc-section-label">Run status</h3>
    <dl class="ccc-detail-fields">
      <dt class="ccc-research-status-row">Last successful run</dt>
      <dd class="ccc-research-status-row">None yet</dd>
      <dt class="ccc-research-status-row">Last failed run</dt>
      <dd class="ccc-research-status-row">
        <span class="ccc-research-state" data-state="failed">
          <span aria-hidden="true">✕</span> <span>Failed</span>
        </span> · <time datetime="2026-10-13T20:58:00.000Z" title="15 hours ago" aria-describedby="ID" class="ccc-research-time">Oct 13, 8:58 PM</time>
        <span id="ID" class="ccc-visually-hidden">15 hours ago</span>
        <span class="ccc-research-reason-text"> — the summariser isn't set up</span>
      </dd>
    </dl>
    <p class="ccc-field-help">Each run fetches the 3 configured sources and makes one summariser call.</p>
    <div class="ccc-research-sources-config">
      <button type="button" class="ccc-connect-button" data-variant="tertiary" aria-expanded="false" aria-controls="ID">Show configured sources (3)</button>
