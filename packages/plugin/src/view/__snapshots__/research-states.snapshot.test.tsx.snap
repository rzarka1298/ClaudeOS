exports[`the Research destination states, as markup > disconnected: dimmed with last-good values, Run now blocked with its reason 1`] = `
"<section class="ccc-research" aria-labelledby="ID" data-dimmed="true">
  <div class="ccc-research-header">
    <h2 id="ID" tabindex="-1">Research</h2>
    <div class="ccc-research-run">
      <button type="button" class="ccc-connect-button" data-variant="primary" aria-label="Run now: fetch the sources and write a research report" aria-disabled="true" aria-describedby="ID">Run now</button>
      <span id="ID" class="ccc-research-reason">The companion service isn't running.</span>
    </div>
  </div>
  <p class="ccc-research-subline">Research sources</p>
  <div class="ccc-research-strip">
    <footer class="ccc-card-footer">
      <time class="ccc-footer-time" datetime="2026-10-14T11:00:00.000Z" title="FOOTER-TIME" aria-describedby="ID-absolute-time" tabindex="0">1 hour ago</time>
      <span id="ID-absolute-time" class="ccc-visually-hidden">FOOTER-TIME</span>
      <span class="ccc-badge" data-badge="unavailable">
        <span class="ccc-badge-glyph" aria-hidden="true">○</span>
        <span class="ccc-visually-hidden">Freshness: </span>
        <span class="ccc-badge-label">Unavailable</span>
      </span>
      <button type="button" class="ccc-source-button" aria-expanded="false" aria-controls="ID-source-panel">Source</button>
      <div id="ID-source-panel" class="ccc-source-panel" hidden="">
        <p class="ccc-visually-hidden">Sources for research</p>
        <ul class="ccc-source-list">
          <li class="ccc-source-row">Research reports — disconnected</li>
        </ul>
      </div>
    </footer>
  </div>
  <p class="ccc-research-status" role="status">
  </p>
  <section class="ccc-research-run-status" aria-labelledby="ID">
    <h3 id="ID" class="ccc-section-label">Run status</h3>
    <dl class="ccc-detail-fields">
      <dt class="ccc-research-status-row">Last successful run</dt>
      <dd class="ccc-research-status-row">None yet</dd>
      <dt class="ccc-research-status-row">Last failed run</dt>
      <dd class="ccc-research-status-row">None</dd>
    </dl>
  </section>
  <section aria-labelledby="ID">
    <h3 id="ID" class="ccc-section-label">Reports</h3>
    <div class="ccc-research-layout" data-reader-open="false">
      <div class="ccc-research-list-cell">
        <div class="ccc-report-list-region" data-dimmed="true">
          <ul class="ccc-report-list">
            <li class="ccc-report-row">
              <button type="button" class="ccc-report-row-button">
                <span class="ccc-clamp-2" title="Developer tooling and open-source releases — Oct 14, 2026">Developer tooling and open-source releases — Oct 14, 2026</span>
                <span class="ccc-report-row-meta">
                  <time datetime="2026-10-14T11:00:00.000Z" title="Oct 14, 11:00 AM" aria-describedby="ID" class="ccc-research-time">1 hour ago</time>
                  <span id="ID" class="ccc-visually-hidden">Oct 14, 11:00 AM</span> · <span class="ccc-badge" data-badge="cached">
                  <span class="ccc-badge-glyph" aria-hidden="true">◐</span>
                  <span class="ccc-visually-hidden">Freshness: </span>
                  <span class="ccc-badge-label">Cached</span>
                </span> · 3 sources · 12 items</span>
              </button>
            </li>
            <li class="ccc-report-row" data-unreadable="true">
              <p class="ccc-report-title">
                <span class="ccc-error-glyph" aria-hidden="true">▲</span>Unreadable report</p>
                <p class="ccc-report-row-meta" id="ID">
                  <span class="ccc-mono">broken-report.md</span> · Its metadata couldn't be read.</p>
                  <button type="button" class="ccc-row-action" aria-describedby="ID">Open note</button>
                </li>
              </ul>
            </div>
          </div>
          <div class="ccc-research-reader-cell">
            <p class="ccc-research-placeholder">Select a report to read it.</p>
          </div>
        </div>
      </section>
    </section>"
`;

