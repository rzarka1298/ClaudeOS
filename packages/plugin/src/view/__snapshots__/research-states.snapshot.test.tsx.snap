</div>
</div>
<div class="ccc-setup-callout" role="note">
  <p class="ccc-research-callout-heading">The summariser isn't set up</p>
  <p>Research runs need an Anthropic API key in the macOS keychain. Store one with the research key setup script, then press Run now. macOS may ask once to allow keychain access.</p>
</div>
</section>
<section aria-labelledby="ID">
  <h3 id="ID" class="ccc-section-label">Reports</h3>
  <div class="ccc-research-layout" data-reader-open="false">
    <div class="ccc-research-list-cell">
      <div class="ccc-report-list-region">
        <div class="ccc-report-list-empty">
          <p class="ccc-report-empty-heading">No reports yet</p>
          <p class="ccc-research-subline">No run has produced a report yet. The last failed run says why.</p>
        </div>
      </div>
    </div>
    <div class="ccc-research-reader-cell">
      <p class="ccc-research-placeholder">Select a report to read it.</p>
    </div>
  </div>
</section>
</section>"
`;

