{
  "name": "claude-command-center",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "setup": "sh scripts/preflight.sh && pnpm install && turbo run build",
    "service:install": "sh scripts/launchagent/install.sh",
    "service:uninstall": "sh scripts/launchagent/uninstall.sh",
    "service:restart": "sh scripts/launchagent/restart.sh",
    "dev:service": "sh scripts/launchagent/uninstall.sh && node packages/service/dist/main.js",
    "ci:format": "biome ci .",
    "ci:lint": "biome lint .",
    "ci:boundaries": "turbo run build && eslint --config eslint.config.mjs packages --ext .ts,.tsx --ignore-pattern 'packages/test-fixtures/boundary-violations/**' --ignore-pattern 'packages/plugin/lint-fixtures/**'",
    "ci:backstop": "sh scripts/check-boundaries.sh",
    "ci:obsidianmd": "cd packages/plugin && pnpm exec eslint --config eslint.config.mjs src --ext .ts,.tsx",
    "ci:typecheck": "turbo run typecheck",
    "ci:test": "turbo run test",
    "ci:privacy": "sh scripts/check-privacy.sh",
    "ci:visual": "pnpm --filter @ccc/test-fixtures run harness:build && playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.4",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "10.10.0",
    "eslint-plugin-boundaries": "7.2.0",
    "turbo": "2.10.13",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  }
}
