{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CodexWorkerReport",
  "description": "Final message shape for a Codex worker task run under a Claude orchestrator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "files_changed",
    "commands_run",
    "tests",
    "deviations",
    "open_questions"
  ],
  "properties": {
    "status": { "type": "string", "enum": ["done", "blocked", "failed"] },
    "summary": { "type": "string" },
    "files_changed": { "type": "array", "items": { "type": "string" } },
    "commands_run": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit_code"],
        "properties": {
          "command": { "type": "string" },
          "exit_code": { "type": ["integer", "null"] }
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failed"],
      "properties": {
        "passed": { "type": "integer" },
        "failed": { "type": "integer" }
      }
    },
    "deviations": { "type": "array", "items": { "type": "string" } },
    "open_questions": { "type": "array", "items": { "type": "string" } }
  }
}
