node_modules/
dist/
.turbo/
*.tsbuildinfo
packages/plugin/main.js
packages/plugin/styles.css
.env
.env.local
.claude/settings.local.json
.privacy-denylist.local
# Owner-supplied visual reference for the prototype round (D-06): informs the
# prototypes, is never committed, quoted or transcribed into a tracked file.
docs/design/prototypes/reference.local.*
coverage/
# Visual-regression harness build output (plan 03-09) — regenerated by
# `pnpm run ci:visual`. Already covered by `dist/` above; named explicitly so
# the harness's ignore survives any future narrowing of that rule.
packages/test-fixtures/harness/dist/
# Playwright run artifacts. Baselines live in visual/*-snapshots/ and are
# committed only from the Linux container (plan 03-10); reports never are.
test-results/
playwright-report/
# The snapshot directory is an allowlist (D-22, plan 03-10): only the pinned
# Linux container's `*-chromium-linux.png` may be tracked. A `*-darwin.png` or
# `*-win32.png` from a host run — or anything else written there — is ignored,
# so it cannot be staged by accident. `scripts/check-images.sh` is the CI half.
packages/test-fixtures/visual/widgets.spec.ts-snapshots/*
!packages/test-fixtures/visual/widgets.spec.ts-snapshots/*-chromium-linux.png
.DS_Store
.obsidian/
PRIVACY-GATE-REPORT.md

# GSD local runtime state (isolation sentinels, never shared)
.gsd/

# Owner UAT layout override (dev vault symlinks this folder) — never commit
packages/plugin/layout.json

# Codex wrapper runtime state (reports, sessions, live logs, pending resume):
# local-only, may hold command output and absolute worktree paths.
.planning/codex/
